# ---------------------------------------------------------------
# CivicFix server configuration. Copy to .env and edit values.
# NEVER commit your real .env file.
# ---------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/civicfix

# JWT - use a long random string (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=1d

# Frontend origin(s) allowed by CORS (comma-separated, no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Auth cookie settings
# Local dev (same-site through the Vite proxy): COOKIE_SECURE=false, COOKIE_SAME_SITE=lax
# Production on different domains over HTTPS:   COOKIE_SECURE=true,  COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Uploads (local disk storage under server/uploads)
MAX_UPLOAD_MB=2

# Complaint statuses in which a citizen may still edit/delete their complaint
CITIZEN_EDITABLE_STATUSES=Pending

# First-admin bootstrap (used ONLY by `npm run create-admin` and the seed script,
# never by the HTTP API). Leave ADMIN_PASSWORD empty to be prompted for one.
ADMIN_NAME=CivicFix Administrator
ADMIN_EMAIL=admin@civicfix.local
ADMIN_PASSWORD=

# Set to true only when running behind a reverse proxy (Render, Railway, Nginx...)
TRUST_PROXY=false
