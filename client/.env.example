# Base URL of the CivicFix API.
# Local development: keep "/api/v1" - Vite proxies it to the backend (see vite.config.js),
# so the auth cookie is first-party and no CORS setup is needed.
# Production (separate hosting): the full backend URL, e.g. https://civicfix-api.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

# Backend address used by the Vite dev proxy (development only)
VITE_DEV_PROXY_TARGET=http://localhost:5000
